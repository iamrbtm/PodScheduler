SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://podscheduler:podscheduler@db:5432/podscheduler

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Admin seed account (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_USERNAME=admin

# Object storage for episode audio (self-hosted MinIO, S3-compatible)
MINIO_ROOT_USER=podscheduler
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-string
MINIO_BUCKET=podscheduler-media
# Internal Docker address the app uses to talk to MinIO
MINIO_ENDPOINT=http://minio:9000

# Public domain distributors and RSS feed enclosures are served from.
# Must be a real domain with DNS pointed at this server — Apple/Spotify/etc.
# fetch your feed and audio files from the public internet, not localhost.
PUBLIC_DOMAIN=localhost
PUBLIC_BASE_URL=http://localhost
