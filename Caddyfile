{$PUBLIC_DOMAIN} {
	# Episode audio lives in the MinIO bucket. Directories fetch these
	# URLs directly, so this path must stay public and unauthenticated.
	handle_path /media/* {
		rewrite * /{$MINIO_BUCKET}{uri}
		reverse_proxy minio:9000
	}

	# Everything else (app pages, /feed/<slug>.xml) goes to Flask.
	reverse_proxy web:5000
}
